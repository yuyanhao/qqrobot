# qqrobot 配置模板，适用于 2核2G、单个重任务。
# 复制为 .env 并填写以下三项；不要把填好的 .env 发给别人。
# 密钥含 $、# 等字符时请用单引号包裹，兼容 dotenv / systemd / Compose。
QQ_APPID=
QQ_SECRET=
# ── 模型接口 ───────────────────────────────────────────────────────────
# 默认 DeepSeek；只填 DEEPSEEK_API_KEY 的旧配置可以直接升级，无需改动。
# 换用其他 OpenAI 兼容接口时，设置 LLM_PROVIDER、LLM_API_KEY、LLM_MODEL。
# LLM_PROVIDER 可选：deepseek / openai / openrouter / anthropic / gemini /
# qwen / moonshot / zhipu / siliconflow / ollama / lmstudio / custom
# LLM_BASE_URL 留空使用内置地址；custom 必须填写完整地址。
# LLM_PROVIDER=deepseek
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# 识图模型；留空时使用 LLM_MODEL。模型不支持图片时不要发图片或 PDF 识题。
# LLM_VISION_MODEL=
# 可选 low / high / max；仅 DeepSeek、OpenAI 等支持思考控制的接口会收到。
# LLM_REASONING_EFFORT=high
# 是否发送 response_format=json_object；个别接口不支持时程序会自动去掉后重试。
# LLM_JSON_MODE=true
# 覆盖思考参数格式：deepseek / openai / none；一般无需修改。
# LLM_THINKING=

# 以下 DEEPSEEK_* 为旧变量；未设置对应 LLM_* 时继续读取，便于不改 .env 升级。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Flash 支持识图；即使解题改用 deepseek-v4-pro，这里仍用 Flash。
VISION_MODEL=deepseek-flash
# 可选 low / high / max；默认 high，复杂题再考虑 max。
DEEPSEEK_REASONING_EFFORT=high
# 思考与最终答案共同占用生成额度。留空采用 high=65536、max=131072。
# 可单独覆盖，本程序预算范围 8192..131072；较大额度可能增加耗时和费用。
# 此范围是本程序策略；不是官方当前最高输出上限。
# SOLVE_MAX_TOKENS=65536
# VERIFY_MAX_TOKENS=65536
QQ_API_BASE_URL=https://api.bot.qq.com
# QQ 地址只支持 HTTPS 域名（可带端口），不支持路径前缀；SDK 和媒体发送共用。

# 搜索使用 DeepSeek Search API 格式。DeepSeek 部署默认复用 DEEPSEEK_API_KEY，
# 不需要额外配置；换用其他模型供应商时，搜索仍需 DeepSeek 的密钥：
# 填 SEARCH_API_KEY，或设 SEARCH_ENABLED=false 关闭联网搜索。
SEARCH_ENABLED=true
# SEARCH_API_KEY=
# SEARCH_ENDPOINT=https://api.deepseek.com/v1/tools/search
DEEPSEEK_SEARCH_ENDPOINT=https://api.deepseek.com/v1/tools/search

# 总运行预算包含识题/搜索/计算/解题/复核/排版，不含排队和交付。
TASK_TIMEOUT=1800
SOLVE_TIMEOUT=900
VERIFY_TIMEOUT=600
# 对应合法范围为 120..1800 / 60..1200 / 30..600 秒。
VERIFY_SOLUTION=true
SYMPY_ENABLED=true

# 先以题号领取保障交付；确认 QQ 主动消息权限后可设 true。
ACTIVE_DELIVERY=false
# 2核2G 默认单个重任务；MAX_QUEUE 限制全局未完成任务数（含运行中）。
MAX_QUEUE=5
MAX_USER_TASKS=2
MAX_DAILY_TASKS=50
RESULT_TTL_DAYS=7
RESULT_MAX_MB=512
# 合法范围依次为 1..5 / 1..5 / 1..500 / 1..30 / 64..4096。
# 每日限制按每个会话中的用户计数，不是 API 金额或全机器人总次数硬上限。
# 普通 PDF 每份最多 10 MB。题目 PDF 必须写明物理页码，例如“只读第3-5页”。
# 每份要读取的 PDF 必须明确指定页码；单份 PDF 和单个任务合计默认最多读取 5 页。
# 程序只允许把这两个上限调低到 1..5，超出 5 会拒绝启动。
PDF_INPUT_MAX_PAGES=5
PDF_TASK_MAX_PAGES=5
# 管理员书库 PDF 单份默认最多 100 MB、总量默认最多 1 GB，可按需调整。
BOOK_MAX_PDF_MB=100
BOOK_LIBRARY_MAX_MB=1024
# 旧 PDF_INPUT_PAGES 配置不再使用。
# 可选；直接运行时默认用程序旁的 data；systemd / Docker 固定到各自持久化目录。
# DATA_DIR=/opt/qq-math-bot/data

# 群白名单和单聊用户白名单分开。空=不额外限制已有QQ接入范围。
# 填 QQ 平台实际 OpenID，多个用英文逗号分隔；不是普通 QQ 号码。
ALLOWED_GROUPS=
ALLOWED_USERS=
# 仅此 C2C 用户 OpenID 可以私聊入库或移除书籍，留空则禁用 QQ 内书库管理。
BOOK_ADMIN_OPENID=

# 旧 BOCHA_*、PDF_INPUT_PAGES、PDF_MAX_PAGES、PDF_DPI、MAX_PAGES、
# PDF_ENABLED、PDF_MAX_MB、MAX_IMAGE_MB、TEXT_FILE_MAX_MB、FILE_MAX_MB、
# SYMPY_TIMEOUT 不再控制升级版，无需复制。
# 离线检查（不验证真实接口权限）：.venv/bin/python settings.py
