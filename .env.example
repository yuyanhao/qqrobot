# qqrobot 配置模板，适用于 2核2G、单个重任务。
# 复制为 .env 并填写以下三项；不要把填好的 .env 发给别人。
# 密钥含 $、# 等字符时请用单引号包裹，兼容 dotenv / systemd / Compose。
QQ_APPID=
QQ_SECRET=
DEEPSEEK_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Flash 支持识图；即使解题改用 deepseek-v4-pro，这里仍用 Flash。
VISION_MODEL=deepseek-flash
# 可选 low / high / max；默认 high，复杂题再考虑 max。
DEEPSEEK_REASONING_EFFORT=high
# 思考与最终答案共同占用生成额度。留空采用 high=65536、max=131072。
# 可单独覆盖，本程序预算范围 8192..131072；较大额度可能增加耗时和费用。
# 此范围是本程序策略；不是官方当前最高输出上限。
# SOLVE_MAX_TOKENS=65536
# VERIFY_MAX_TOKENS=65536
QQ_API_BASE_URL=https://api.bot.qq.com
# QQ 地址只支持 HTTPS 域名（可带端口），不支持路径前缀；SDK 和媒体发送共用。

# 解题专用搜索，复用上面的 DEEPSEEK_API_KEY，不需要博查。
SEARCH_ENABLED=true
DEEPSEEK_SEARCH_ENDPOINT=https://api.deepseek.com/v1/tools/search

# 总运行预算包含识题/搜索/计算/解题/复核/排版，不含排队和交付。
TASK_TIMEOUT=1200
SOLVE_TIMEOUT=600
VERIFY_TIMEOUT=300
# 对应合法范围为 120..1800 / 60..1200 / 30..600 秒。
VERIFY_SOLUTION=true
SYMPY_ENABLED=true

# 先以题号领取保障交付；确认 QQ 主动消息权限后可设 true。
ACTIVE_DELIVERY=false
# 2核2G 默认单个重任务；MAX_QUEUE 限制全局未完成任务数（含运行中）。
MAX_QUEUE=5
MAX_USER_TASKS=2
MAX_DAILY_TASKS=50
RESULT_TTL_DAYS=7
RESULT_MAX_MB=512
# 合法范围依次为 1..20 / 1..5 / 1..500 / 1..30 / 64..4096。
# 每日限制按每个会话中的用户计数，不是 API 金额或全机器人总次数硬上限。
# PDF 输入默认读取全部页面；随 PDF 写“只读第3-5页”可限定范围。
# 旧 PDF_INPUT_PAGES 配置不再使用。
# 可选；直接运行时默认用程序旁的 data；systemd / Docker 固定到各自持久化目录。
# DATA_DIR=/opt/qq-math-bot/data

# 群白名单和单聊用户白名单分开。空=不额外限制已有QQ接入范围。
# 填 QQ 平台实际 OpenID，多个用英文逗号分隔；不是普通 QQ 号码。
ALLOWED_GROUPS=
ALLOWED_USERS=

# 旧 BOCHA_*、PDF_INPUT_PAGES、PDF_MAX_PAGES、PDF_DPI、MAX_PAGES、
# PDF_ENABLED、PDF_MAX_MB、MAX_IMAGE_MB、TEXT_FILE_MAX_MB、FILE_MAX_MB、
# SYMPY_TIMEOUT 不再控制升级版，无需复制。
# 离线检查（不验证真实接口权限）：.venv/bin/python settings.py
